<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="TeamMemberMapper">
	
	<insert id="insertTeamMember" parameterType="com.groo.model.TeamMemberDTO">
		INSERT INTO STUDYMEMBER
		(
			MEM_ID,
			STUDY_ID,
			STUDY_ROLL
		)VALUES(
			(SELECT MEM_ID FROM MEMBER WHERE MEM_LOGIN_ID = #{memId}),
			#{studyId},
			#{studyRoll}
		)
	</insert>
	
	<select id="selectAllTeamMember" parameterType="com.groo.model.TeamMemberDTO" resultType="com.groo.model.TeamMemberDTO">
		SELECT * FROM STUDYMEMBER
	</select>
</mapper> 