<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="UserMapper">

<!--     <insert id="insertUser" parameterType="com.groo.model.MemberDTO"> -->
<!-- 		INSERT INTO users (NAME, USER_ID, PASSWORD) -->
<!-- 		VALUES (#{name}, #{userId}, #{password}) -->
<!-- 	</insert>  -->

	<insert id="insertMember" parameterType="com.groo.model.MemberDTO">
		<selectKey keyProperty="memId" resultType="String" order="BEFORE">
           SELECT 'mem_no_' || MEMBER_SEQ.NEXTVAL FROM DUAL
        </selectKey>
	  INSERT INTO MEMBER (
	  						MEM_ID,
	  						MEM_NAME, 
	  						MEM_LOGIN_ID, 
	  						MEM_PASS, 
 	  						MEM_BIRTH,
	  						MEM_GENDER, 
	  						MEM_EMAIL
	  						)
	  			  values (
	  			 			#{memId}, 
	  			 			#{memName}, 
	  			 			#{memLoginId}, 
	  			 			#{memPass}, 
 	  			 			#{memBirth},
	  			 			#{memGender}, 
	  			 			#{memEmail} 
	  					    )
	</insert>

	<select id="loginUser" parameterType="com.groo.model.MemberDTO" resultType="com.groo.model.MemberDTO">
		SELECT *
		FROM USERS
		WHERE USER_ID = #{userId} and PASSWORD = #{password}
	</select>
</mapper>